{
  "name": "smartfin-ai",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:ml": "cd ml-service && .venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8000",
    "dev:all": "npx concurrently -n backend,ml,frontend -c blue,magenta,green \"npm run dev:backend\" \"npm run dev:ml\" \"npm run dev:frontend\""
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
