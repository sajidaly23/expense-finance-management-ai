PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/smartfin_ai
MONGODB_USER=
MONGODB_PASSWORD=
# Required when NODE_ENV=production. Use a long random string.
JWT_SECRET=change-me-in-development
JWT_EXPIRES_IN=7d
ML_SERVICE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
# Required for AI receipt scanning (OpenAI Vision)
AI_API_KEY=
AI_MODEL=gpt-4o-mini
